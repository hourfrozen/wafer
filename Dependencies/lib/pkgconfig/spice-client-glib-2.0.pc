prefix=/Users/runner/actions/runner-2/_work/UTM/UTM/sysroot-iOS-arm64
includedir=${prefix}/include
libdir=${prefix}/lib

exec_prefix=${prefix}

Name: spice-client-glib-2.0
Description: SPICE Client GLib 2.0 library
Version: 0.42
Requires: spice-protocol >=  0.14.3, glib-2.0 >=  2.38, gobject-2.0 >=  2.52, gio-2.0 >=  2.38
Requires.private: pixman-1 >=  0.17.7, openssl >=  1.0.0, opus >=  0.9.14, libjpeg, json-glib-1.0, gio-unix-2.0, libphodav-3.0, libsoup-3.0 >=  3.0, gstreamer-1.0 >=  1.10, gstreamer-base-1.0 >=  1.10, gstreamer-app-1.0 >=  1.10, gstreamer-audio-1.0 >=  1.10, gstreamer-video-1.0 >=  1.10, libusbredirparser-0.5 >=  0.7.1, libusbredirhost >=  0.7.1, libusb-1.0 >=  1.0.21, libucontext
Libs: -L${libdir} -lspice-client-glib-2.0
Libs.private: -lm -lz
Cflags: -I${includedir}/spice-client-glib-2.0
